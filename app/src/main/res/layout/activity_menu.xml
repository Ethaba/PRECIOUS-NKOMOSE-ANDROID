<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FC"
    tools:context=".menu">

    <LinearLayout
        android:id="@+id/layout_menu_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Our Menu"
            android:textColor="#21182B"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Discover something delicious."
            android:textColor="#716879"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/category_sa_mains"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp"
                    android:text="SA Mains"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#7044A0"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/category_starters"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp"
                    android:text="Starters"
                    android:textAllCaps="false"
                    android:textColor="#7044A0"
                    app:backgroundTint="#F0E8FA"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/category_desserts"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp"
                    android:text="Desserts"
                    android:textAllCaps="false"
                    android:textColor="#7044A0"
                    app:backgroundTint="#F0E8FA"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/category_drinks"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="Drinks"
                    android:textAllCaps="false"
                    android:textColor="#7044A0"
                    app:backgroundTint="#F0E8FA"
                    app:cornerRadius="20dp" />

            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/text_category_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="SA Mains"
            android:textColor="#21182B"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_menu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layout_menu_header"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/recycler_menu_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- Starters Section -->
            <LinearLayout
                android:id="@+id/container_starters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/shrimp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Prawn Starter" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Light herb-butter prawns." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/sosaties" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Traditional Sosaties" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apricot-marinated skewers." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/snoek" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Smoked Snoek Bites" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Local Cape favourite on toast." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/prawns" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tiger Prawns" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Jumbo tiger prawns, flame grilled." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/lobster" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lobster Tails" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Garlic butter lobster selection." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Mains Section -->
            <LinearLayout
                android:id="@+id/container_mains"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/stew" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Beef Stew" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Traditional hearty stew." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/steak" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Grilled Steak" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aged ribeye selection." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/bobotie" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Malay Bobotie" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cape Malay spiced mince." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/bunnychow" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bunny Chow" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Spicy curry in bread loaf." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/gatsby" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Full Gatsby" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cape sharing sub." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/worsandpap" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Boerewors &amp; Pap" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Served with chakalaka sauce." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/steambreadbeans" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Steam Bread &amp; Beans" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Warm dombolo and beans." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/sevencolours" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Seven Colours" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Traditional Sunday feast." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/curryandrice" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Curry &amp; Rice" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Meat curry with basmati." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/fillet" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Beef Fillet" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tender beef medallions." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/seafbkingf" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Seafood Kingfish" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pan-seared local kingfish." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/seafoodboil" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Seafood Boil" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Premium mixed seafood platter." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Desserts Section -->
            <LinearLayout
                android:id="@+id/container_desserts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/malvapudding" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Malva Pudding" android:textColor="#21182B" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Warm apricot sponge cake." android:textColor="#716879" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/milktart" />
